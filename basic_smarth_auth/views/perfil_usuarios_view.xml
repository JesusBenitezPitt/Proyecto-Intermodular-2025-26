<odoo>
    <record id="accion_sesion_log" model="ir.actions.act_window">
        <field name="name">Log de Sesiones</field>
        <field name="res_model">autenticacion.sesion.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="vista_sesion_log_list" model="ir.ui.view">
        <field name="name">autenticacion.sesion.log.list</field>
        <field name="model">autenticacion.sesion.log</field>
        <field name="arch" type="xml">
            <list string="Log de Sesiones" editable="bottom">
                <field name="usuario_id"/>
                <field name="fecha_sesion"/>
                <field name="estado_revision"/>
                <field name="notas_admin"/> 
            </list>
        </field>
    </record>

    <menuitem id="menu_autenticacion_basica_root" name="Autenticación Básica"/>
    
    <menuitem 
        id="menu_autenticacion_perfiles" 
        parent="menu_autenticacion_basica_root" 
        name="Perfiles de Usuario" 
        action="base.action_res_users" 
        sequence="10"
    />

    <menuitem 
        id="menu_autenticacion_sesiones" 
        parent="menu_autenticacion_basica_root" 
        name="Log de Sesiones" 
        action="accion_sesion_log"
        sequence="20"
    />
</odoo>