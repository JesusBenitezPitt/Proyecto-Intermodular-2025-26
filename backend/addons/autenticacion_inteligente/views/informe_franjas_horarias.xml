<odoo>
    <record id="action_report_franjas_horarias_pdf" model="ir.actions.report">
        <field name="name">Informe de Franjas Horarias (PDF)</field>
        <field name="model">informe.franjas.horarias</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">autenticacion_inteligente.plantilla_informe_franjas_pdf</field>
        <field name="binding_model_id" ref="autenticacion_inteligente.model_informe_franjas_horarias"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_server_print_franjas_pdf" model="ir.actions.server">
        <field name="name">Exportar PDF</field>
        <field name="model_id" ref="autenticacion_inteligente.model_informe_franjas_horarias"/>
        <field name="binding_model_id" ref="autenticacion_inteligente.model_informe_franjas_horarias"/>
        <field name="binding_type">action</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <field name="state">code</field>
        <field name="code">action = env.ref('autenticacion_inteligente.action_report_franjas_horarias_pdf').report_action(env['informe.franjas.horarias'].search([]))</field>
    </record>

    <record id="view_franjas_horarias_tree" model="ir.ui.view">
        <field name="name">informe.franjas.horarias.tree</field>
        <field name="model">informe.franjas.horarias</field>
        <field name="arch" type="xml">
            <tree string="Accesos por Franja Horaria" create="false" edit="false" delete="false">
                <field name="franja_horaria" string="Franja Horaria"/>
                <field name="total_accesos" string="Total Accesos"/>
                <field name="alertas_ia" string="Alertas IA (Riesgo Alto)"/>
            </tree>
        </field>
    </record>

    <template id="plantilla_informe_franjas_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Informe de Accesos por Franja Horaria</h2>
                    <p class="text-muted">Análisis agregado de todos los intentos de autenticación clasificados por momento del día.</p>
                    <table class="table table-bordered table-sm mt32">
                        <thead class="thead-dark">
                            <tr>
                                <th>Franja Horaria</th>
                                <th class="text-center">Total Accesos</th>
                                <th class="text-center">Alertas IA (Riesgo Alto)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="o">
                                <tr>
                                    <td><span t-field="o.franja_horaria"/></td>
                                    <td class="text-center"><span t-field="o.total_accesos"/></td>
                                    <td class="text-center"><span t-field="o.alertas_ia"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
